<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ERP.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ERP.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="ERP">

    <!-- Aşşağıda ilk yazılan sayfa uygulama başlatılınca açılan sayfadır.yazdığınız pagei diğer shellcontentlerin yukarısında olacak şkilde ekle böylece ekranda görüntüleyebilirsiniz. -->
    
    <ShellContent Title="Login Page" ContentTemplate="{DataTemplate views:LoginPage}"/>
    <ShellContent Title="Menu" ContentTemplate="{DataTemplate views:MainPage}"/>

   


</Shell>
