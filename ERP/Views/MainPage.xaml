<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ERP.Views.MainPage"
             Title="Ana Sayfa"
             xmlns:local="clr-namespace:ERP.ViewModels"
             x:DataType="local:MainViewModel">

    <ContentPage.BindingContext>
        <local:MainViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- Grid Yapısı -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <!-- Sol Menü -->
            <ColumnDefinition Width="*" />
            <!-- Sağ İçerik -->
        </Grid.ColumnDefinitions>

        <!-- Sol Navigasyon Menüsü -->
        <StackLayout Grid.Column="0" 
                     BackgroundColor="#2C3E50" 
                     Padding="10">
            <!-- Logo veya Başlık -->
            <Label Text="Menü" 
                   FontSize="20" 
                   HorizontalOptions="Center" 
                   TextColor="White" 
                   Margin="0,10,0,20" />

            <!-- Navigasyon Butonları -->
            <Button Text="Depo" 
                    FontSize="16"
                    CornerRadius="10"
                    BackgroundColor="#34495E"
                    TextColor="White"
                    HeightRequest="50"
                    Margin="0,5"
                    Command="{Binding ButtonClickCommand}" CommandParameter="StockPage"/>

            <Button Text="Depo Giriş" 
                    FontSize="16"
                    CornerRadius="10"
                    BackgroundColor="#34495E"
                    TextColor="White"
                    HeightRequest="50"
                    Margin="0,5"
                    Command="{Binding ButtonClickCommand}" CommandParameter="StockEntryPage"/>

            <Button Text="Depo İşlem Geçmişi" 
                    FontSize="16"
                    CornerRadius="10"
                    BackgroundColor="#34495E"
                    TextColor="White"
                    HeightRequest="50"
                    Margin="0,5"
                    Command="{Binding ButtonClickCommand}" CommandParameter="TransactionHistoryPage"/>

            
            <Button Text="Çıkış" 
                    FontSize="16"
                    CornerRadius="10"
                    BackgroundColor="#E74C3C"
                    TextColor="White"
                    HeightRequest="50"
                    Margin="0,5"
                    Command="{Binding ButtonClickCommand}" CommandParameter="LoginPage"/> <!--çıkış amaçlı menü butonu--> 

        </StackLayout>

        <!-- Sağ İçerik Alanı -->
        <ContentView Grid.Column="1"
                     BackgroundColor="White">
            <Label Text="Hoşgeldiniz!"
                   FontSize="24"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </ContentView>
    </Grid>
</ContentPage>