<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="Proje2.MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sol panel: Görsel için  -->
        <StackLayout
         Grid.Column="0"
         BackgroundColor="#3498db"
         HorizontalOptions="FillAndExpand"
         VerticalOptions="CenterAndExpand">
            <Image
             Aspect="AspectFit"
             HorizontalOptions="Center"
             Source="logo.png"
             VerticalOptions="Center" />
        </StackLayout>

        <!--  Sağ panel: Giriş ve kayıt formu için  -->
        <StackLayout
         Grid.Column="1"
         Padding="20"
         BackgroundColor="FloralWhite"
         HorizontalOptions="FillAndExpand"
         VerticalOptions="FillAndExpand">
            <!--  Hoşgeldiniz Alanı, Lacivert Frame  -->
            <material:ButtonView
             Margin="0,0,0,20"
             Padding="20"
             BackgroundColor="DarkBlue"
              >
       
                <Label
                 FontSize="24"
                 HorizontalOptions="Center"
                 Text="Welcome"
                 TextColor="White"
                 VerticalOptions="CenterAndExpand" />
            </material:ButtonView>

            <!--  Kullanıcı adı Entry ve Şifre Entry  -->
            <StackLayout x:Name="LoginForm" IsVisible="True">
                <material:TextField
            x:Name="UsernameEntry"
              Title="Username"
              
              TitleColor="DarkBlue"
              BorderColor="DarkBlue"
              TextColor="DarkBlue"
              CornerRadius="25"
              Padding="10"
              HeightRequest="75"
             
              Margin="0, 10, 0, 0"  />
                   
                <material:TextField
                    x:Name="PasswordEntry"
                    Title="Password"
                    CornerRadius="25"
                    Padding="10"
                    TextColor="DarkBlue"
                    TitleColor="DarkBlue"
                    BorderColor="DarkBlue"
                    HeightRequest="75"
                    IsPassword="True"
                    MaxLength="5"
                 
                    />
               
                <Button
                    x:Name="LoginButton" 
                    BackgroundColor="DarkBlue"
                    Text="Login"
                    StyleClass="Elevated"
                   CornerRadius="25"
                    HeightRequest="50"
                    WidthRequest="450"
                    Padding="0"
                    Clicked="OnLoginButtonClicked"
                    />


                <!--  Şifremi Unuttum ve Kayıt Ol Bölümü  -->
                <StackLayout
                 Margin="0,20,0,0"
                 HorizontalOptions="Center"
                 Orientation="Horizontal">
                    <Button
                     x:Name="ForgotPasswordButton"
                     BackgroundColor="Transparent"
                     FontSize="14"
                     Text="Forgot Password?"
                     TextColor="Blue" />
                    <Label
                     Margin="10,0"
                     FontSize="14"
                     HorizontalOptions="Center"
                     Text="|"
                     TextColor="Blue"
                     VerticalOptions="Center" />
                    <Button
                     x:Name="RegisterButton"
                     BackgroundColor="Transparent"
                     Clicked="OnRegisterButtonClicked"
                     FontSize="14"
                     Text="Register"
                     TextColor="Blue" />
                </StackLayout>
            </StackLayout>

            <!--  Kayıt Olma Alanları, Geri Dön Butonu ile Gizlenecek  -->
            <StackLayout
             x:Name="RegisterForm"
             Margin="0,20,0,0"
             IsVisible="False">
                <material:TextField
                    Title="Name"
                    TitleColor="DarkBlue"
                     BorderColor="DarkBlue"
                    TextColor="DarkBlue"
                    Padding="10"
                    
                    CornerRadius="50"
             
                    ></material:TextField>
                <material:TextField
                    Title="Surname"
                    TitleColor="DarkBlue"
                    BorderColor="DarkBlue"
                    Padding="10"
                    
                    CornerRadius="50">
                    
                </material:TextField>
                <material:TextField
                    Title="Email"
                    TitleColor="DarkBlue"
                    BorderColor="DarkBlue"
                    Padding="10"
                    
                    CornerRadius="50"
                    ></material:TextField>
                <material:TextField
                     Title="Position"
                     TitleColor="DarkBlue"
                     BorderColor="DarkBlue"
                     Padding="10"
                     
                    CornerRadius="50"
                     ></material:TextField>

          
                <Button
                 Margin="0,20,0,0"
                 BackgroundColor="Green"
                 CornerRadius="5"
                 Text="Submit"
                 TextColor="White" />

                <!--  Geri Dön Butonu  -->
                <Button
                 BackgroundColor="Transparent"
                 Clicked="OnGoBackClicked"
                 FontSize="14"
                 Text="Go Back to Login Page"
                 TextColor="Blue" />
            </StackLayout>
        </StackLayout>
    </Grid>

</ContentPage>
